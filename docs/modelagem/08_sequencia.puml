@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam dpi 150
skinparam roundcorner 0
skinparam maxMessageSize 180
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 12
skinparam BoxPadding 8
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F5F5F5
skinparam classBorderColor #333333
skinparam sequenceParticipantBackgroundColor #F5F5F5
skinparam sequenceParticipantBorderColor #333333
hide empty methods
actor Usuário as U
participant "PessoaCadastro\nPanel" as T
participant "Pessoa\nController" as C
participant PessoaDAO as D
database PostgreSQL as B
U -> T : preencher pessoa e endereço opcional
T -> T : consultar CEP com ViaCepService
T -> C : salvar(pessoa)
C -> C : validar documento e papéis
C -> D : verificar duplicidade de documento
D -> B : consultar pessoa_documento
C -> D : salvar(pessoa)
D -> B : persistir pessoa e endereço em transação
B --> T : confirmação ou erro
@enduml

@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam dpi 150
skinparam roundcorner 0
skinparam maxMessageSize 180
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 12
skinparam BoxPadding 8
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F5F5F5
skinparam classBorderColor #333333
skinparam sequenceParticipantBackgroundColor #F5F5F5
skinparam sequenceParticipantBorderColor #333333
hide empty methods
actor Usuário as U
participant "OrdemServico\nConsultaPanel" as T
participant "OrdemServico\nController" as C
participant "OrdemServicoDAO\nEstoqueDAO" as D
database PostgreSQL as B
U -> T : cancelar e confirmar devolução integral
T -> C : cancelar(os)
C -> D : cancelar(id, usuario)
group Transação
D -> B : bloquear OS e validar status editável
D -> B : devolver peças e registrar entradas
D -> B : atualizar CANCELADA e data
end
D --> T : cancelamento confirmado
note over T,B : OS cancelada não integra os recebimentos
@enduml
